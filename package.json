{
  "name": "screenflavor",
  "version": "1.0.11",
  "description": "Desktop screen mini-games (ScreenFlavor)",
  "repository": {
    "type": "git",
    "url": "https://github.com/SmallerBytes/ScreenFlavor.git"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5188 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5188 electron .\"",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder --publish never",
    "preview": "vite preview"
  },
  "dependencies": {},
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.screenflavor.app",
    "productName": "ScreenFlavor",
    "publish": null,
    "icon": "electron/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowElevation": true,
      "perMachine": false,
      "runAfterFinish": true
    }
  }
}
